@startuml UC-02_kalendar_ii
!include style.iuml
title UC-02. Календарь, ОРИОКС, учебная нагрузка и ИИ-ассистент (ТЗ v12)
left to right direction

actor "Пользователь\n(студент)" as U
actor "ОРИОКС" as OR <<внешняя система>>
actor "LLM API" as LLM <<внешняя система>>

rectangle "Adaptive AI Planner" {
  package "Календарь, ОРИОКС и нагрузка" {
    usecase "UC-14 Просмотреть календарь\n(ФТ-21, ФТ-25)" as UC14
    usecase "UC-15 Запланировать событие\nили интервал задачи (ФТ-22)" as UC15
    usecase "UC-16 Подключить ОРИОКС\n(ФТ-43)" as UC16
    usecase "UC-17 Обновить расписание\n(ФТ-23)" as UC17
    usecase "Загрузить файл расписания\n(ФТ-24)" as UC17F
    usecase "UC-18 Просмотреть учебные задания\n(ФТ-26)" as UC18
    usecase "UC-19 Получить рекомендации\nпо нагрузке (ФТ-27–ФТ-29)" as UC19
  }

  package "ИИ-ассистент" {
    usecase "UC-20 Создать или изменить задачу\nили событие через ИИ (ФТ-35, ФТ-36)" as UC20
    usecase "UC-21 Декомпозировать цель\n(ФТ-37)" as UC21
    usecase "UC-22 Проверить и подтвердить\nпредложение ИИ (ФТ-38, ФТ-39)" as UC22
    usecase "UC-23 Просмотреть и выгрузить\nисторию запросов к ИИ (ФТ-40)" as UC23
  }
}

U --> UC14
U --> UC15
U --> UC16
U --> UC17
U --> UC18
U --> UC19
U --> UC20
U --> UC21
U --> UC23

UC16 --> OR
UC17 --> OR
UC18 --> OR
UC15 .> UC14 : <<extend>>
UC17F .> UC17 : <<extend>>\n[ОРИОКС недоступен\nили не подключён]
UC20 .> UC22 : <<include>>
UC21 .> UC22 : <<include>>
UC20 --> LLM
UC21 --> LLM

note right of UC16
  Расписание и задания из ОРИОКС
  доступны после подключения (UC-16)
end note
@enduml
