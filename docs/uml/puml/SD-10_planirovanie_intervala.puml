@startuml SD-10_planirovanie_intervala
!include seqhead.iuml
title SD-10. Планирование интервала задачи с проверкой пересечений (ФТ-21, ФТ-22, ФТ-25)
actor "Пользователь" as U
box "Браузер" #F7FAFD
participant "Календарь" as UI
end box
box "Сервер" #FBF7F2
participant "REST API" as API
participant "CalendarService" as CS
database "PostgreSQL" as DB
end box

U -> UI : перетащить задачу\nна свободное время
UI -> API : POST /schedule-items\n{taskId, startAt, endAt}
API -> CS : createScheduleItem(userId, данные)
alt конец не позже начала
  API --> UI : 422 VALIDATION_ERROR
  UI --> U : «Время окончания должно\nбыть позже начала»
else время корректно
  CS -> DB : INSERT schedule_items
  alt задача не найдена у пользователя
    DB --> CS : foreign_key_violation
    API --> UI : 404 NOT_FOUND
  else интервал сохранён
    DB --> CS : интервал
    CS -> DB : calendar_overlaps(userId,\nотображаемая неделя)
    DB --> CS : пересечения
    API --> UI : 201, интервал и пересечения
    UI --> U : интервал в календаре\n(в часовом поясе профиля)
    opt есть пересечения
      UI --> U : пересечение подсвечено
      alt перенести
        U -> UI : сдвинуть интервал
        UI -> API : PATCH /schedule-items/{id}\n{startAt, endAt}
        API -> CS : updateScheduleItem(userId, id, данные)
        CS -> DB : UPDATE schedule_items
      else оставить как есть
        U -> UI : закрыть подсказку
      end
    end
  end
end
@enduml
