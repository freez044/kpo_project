@startuml AD-05_rezervnaya_kopiya
!include style.iuml
title AD-05. Выгрузка и восстановление резервной копии (ФТ-03, ФТ-04, НД-04)
start
if (Действие) then (выгрузить)
  :Выгрузить все таблицы и файлы в JSON;
  :Отдать файл пользователю;
  stop
else (восстановить)
  :Выбрать файл резервной копии;
  :Предупредить о замене текущих данных;
  if (Пользователь подтвердил?) then (нет)
    stop
  else (да)
  endif
  :Проверить формат, имя базы и версию схемы;
  if (Файл подходит?) then (нет)
    :Сообщить, что файл не является
    резервной копией;
    stop
  else (да)
  endif
  :Сделать снимок текущих данных;
  :Очистить таблицы и импортировать файл;
  if (Импорт успешен?) then (да)
    :Показать восстановленные данные;
  else (нет)
    :Вернуть данные из снимка;
    :Сообщить, что файл повреждён,
    текущие данные не изменены;
  endif
  stop
endif
@enduml
