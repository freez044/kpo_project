@startuml SD-01_profil
!include seqhead.iuml
title SD-01. Первый запуск и заполнение профиля (ФТ-01, ФТ-02)
actor "Пользователь" as U
box "Браузер пользователя" #F7FAFD
participant "Веб-интерфейс" as UI
participant "Модуль профиля\nи хранения" as PM
database "Хранилище\n(IndexedDB)" as DB
end box

U -> UI : открыть приложение
UI -> PM : initStorage()
PM -> DB : открыть базу, запросить\nпостоянное хранение
DB --> PM : база открыта
PM -> DB : получить профиль
DB --> PM : профиль не найден
PM --> UI : требуется первичная настройка
UI --> U : форма профиля и предупреждение,\nчто данные хранятся в этом браузере
U -> UI : имя, фамилия, группа, часовой пояс
UI -> PM : сохранить профиль
PM -> PM : проверить обязательные поля
alt данные корректны
  PM -> DB : записать профиль
  DB --> PM : ok
  PM --> UI : профиль сохранён
  UI --> U : главная страница
else ошибка проверки
  PM --> UI : ошибка с указанием поля
  UI --> U : подсветить поле с ошибкой
end
@enduml
