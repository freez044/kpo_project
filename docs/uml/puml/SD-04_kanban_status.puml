@startuml SD-04_kanban_status
!include seqhead.iuml
title SD-04. Изменение статуса на канбан-доске (ФТ-17, ФТ-30)
actor "Пользователь" as U
box "Браузер пользователя" #F7FAFD
participant "Канбан-доска" as UI
participant "Модуль задач\nи целей" as TM
database "Хранилище\n(IndexedDB)" as DB
end box

U -> UI : перетащить карточку\nв другую колонку
UI -> TM : setTaskStatus(id, новый статус)
alt новый статус DONE
  TM -> DB : статус = DONE,\ncompletedAt = текущее время
else задача была DONE
  TM -> DB : новый статус,\nудалить completedAt
else другой переход
  TM -> DB : новый статус
end
DB --> TM : ok
TM --> UI : задача обновлена
UI --> U : карточка в новой колонке,\nпрогресс цели пересчитан
@enduml
