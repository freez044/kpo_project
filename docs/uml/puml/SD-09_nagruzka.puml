@startuml SD-09_nagruzka
!include seqhead.iuml
title SD-09. Главная страница, учебная нагрузка и рекомендации (ФТ-20, ФТ-26–ФТ-29)
actor "Пользователь" as U
box "Браузер" #F7FAFD
participant "Главная страница" as UI
end box
box "Сервер" #FBF7F2
participant "REST API" as API
participant "PlanningService" as PS
participant "OrioksService" as OS
database "PostgreSQL" as DB
end box
participant "ОРИОКС" as OR

U -> UI : открыть приложение
UI -> API : GET /dashboard
API -> PS : getDashboard(userId)
opt ОРИОКС подключён и задания давно не обновлялись
  PS -> OS : sync(userId)
  OS -> OR : дисциплины и контрольные\nмероприятия студента
  alt ОРИОКС доступен
    OR --> OS : мероприятия и недели
    OS -> OS : срок = конец учебной недели;\nexternalId = дисциплина:вид:неделя
    OS -> DB : CALL upsert_assignments()
  else ОРИОКС недоступен
    OS --> PS : ошибка
    note right of PS : используются ранее\nсохранённые задания;\nв ответе предупреждение
  end
end
PS -> DB : workload_by_week(); невыполненные\nзадания; просроченные задачи;\nплан на сегодня
DB --> PS : записи
PS -> PS : выбрать рекомендацию
alt несколько близких сроков
  PS -> PS : предупреждение о нагрузке
else текущая нагрузка ниже следующей
  PS -> PS : совет начать задания заранее
else иначе
  PS -> PS : рекомендаций нет
end
API --> UI : 200, план, просроченные, сроки,\nзадания, рекомендация
UI --> U : главная страница;\nпросроченное выделено
opt пользователь реагирует
  alt «Скрыть»
    U -> UI : скрыть рекомендацию
  else «Перейти к заданию»
    U -> UI : открыть задание
    note right of UI : планирует или меняет\nзадачи сам — Система\nничего не меняет (ФТ-29)
  end
end
@enduml
