@startuml SD-09_nagruzka
!include seqhead.iuml
title SD-09. Оценка учебной нагрузки и рекомендации (ФТ-26–ФТ-29)
actor "Пользователь" as U
box "Браузер пользователя" #F7FAFD
participant "Главная страница" as UI
participant "Модуль контроля\nнагрузки" as LM
database "Хранилище\n(IndexedDB)" as DB
end box
box "Сервер" #FBF7F2
participant "Серверная часть\n(FastAPI)" as SRV
end box
participant "ОРИОКС" as OR

U -> UI : открыть приложение
UI -> LM : refreshLoad()
LM -> SRV : GET /orioks/assignments
SRV -> OR : запрос заданий
alt ОРИОКС доступен
  OR --> SRV : задания и сроки
  SRV --> LM : задания (JSON)
  LM -> DB : upsertAssignments()\nпо externalId
else ОРИОКС недоступен
  SRV --> LM : ошибка
  LM --> UI : «Данные ОРИОКС не обновлены»
  note right of LM : используются ранее\nсохранённые задания
end
LM -> DB : невыполненные задания и задачи\n(включая просроченные)
DB --> LM : записи
LM -> LM : нагрузка по неделям:\nколичество, сроки,\nприоритеты, статусы
alt несколько близких сроков
  LM --> UI : предупреждение о нагрузке
else текущая нагрузка ниже следующей
  LM --> UI : совет начать задания заранее
else иначе
  LM --> UI : рекомендаций нет
end
UI --> U : список заданий, просроченные\nвыделены, рекомендация
opt пользователь реагирует
  alt «Скрыть»
    U -> UI : скрыть рекомендацию
  else «Перейти к заданию»
    U -> UI : открыть задание
    note right of UI : планирует или меняет\nзадачи сам — Система\nничего не меняет (ФТ-29)
  end
end
@enduml
