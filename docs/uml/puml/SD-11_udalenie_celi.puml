@startuml SD-11_udalenie_celi
!include seqhead.iuml
title SD-11. Удаление цели (ФТ-13, НД-03)
actor "Пользователь" as U
box "Браузер пользователя" #F7FAFD
participant "Страница цели" as UI
participant "Модуль задач\nи целей" as TM
database "Хранилище\n(IndexedDB)" as DB
end box

U -> UI : удалить цель
UI -> TM : goalDeletionPreview(id)
TM -> DB : посчитать задачи и файлы цели
DB --> TM : 5 задач, 2 файла
TM --> UI : состав изменений
UI --> U : «Задачи (5) останутся без цели,\nфайлы цели (2) будут удалены»
alt подтверждено
  U -> UI : «Удалить цель»
  UI -> TM : deleteGoal(id)
  group транзакция
    TM -> DB : у задач цели убрать\ngoalId и порядок
    TM -> DB : удалить файлы цели
    TM -> DB : удалить цель
  end
  alt успешно
    DB --> TM : ok
    TM --> UI : цель удалена
    UI --> U : список целей; задачи\nостались на канбан-доске
  else ошибка
    DB --> TM : изменения отменены
    UI --> U : «Не удалось удалить цель»
  end
else отмена
  U -> UI : «Отмена»
end
@enduml
