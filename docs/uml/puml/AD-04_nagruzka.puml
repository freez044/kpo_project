@startuml AD-04_nagruzka
!include style.iuml
title AD-04. Рекомендации по учебной нагрузке (ФТ-26–ФТ-29)
start
if (ОРИОКС подключён и задания\nдавно не обновлялись?) then (да)
  :Запросить задания из ОРИОКС;
  if (ОРИОКС доступен?) then (да)
    :Обновить задания по externalId;
  else (нет)
    :Взять сохранённые задания;
    :Предупредить, что данные ОРИОКС
    не обновлены;
  endif
else (нет)
  :Взять сохранённые задания;
endif
:Собрать невыполненные задачи пользователя,
включая просроченные;
:Оценить нагрузку по неделям
(количество, сроки, приоритеты, статусы);
if (Несколько близких сроков?) then (да)
  :Показать предупреждение о повышенной нагрузке;
else (нет)
  if (Текущая нагрузка ниже следующей\nили нет ближайших заданий?) then (да)
    :Предложить заранее заняться
    предстоящими заданиями;
  else (нет)
    :Рекомендаций нет;
    stop
  endif
endif
if (Пользователь принял рекомендацию?) then (да)
  :Пользователь сам планирует
  или меняет задачи;
else (нет)
  :Скрыть рекомендацию;
endif
note right
  Система не меняет задачи,
  статусы и календарь
  автоматически (ФТ-29)
end note
stop
@enduml
