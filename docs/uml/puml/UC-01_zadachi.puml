    usecase "Отфильтровать задачи\n(ФТ-18)" as UC07F
    usecase "UC-08 Управлять целями\n(ФТ-10–ФТ-13)" as UC08
    usecase "UC-09 Управлять категориями\n(ФТ-14–ФТ-16)" as UC09
    usecase "UC-10 Прикрепить файл\n(ФТ-33–ФТ-35)" as UC10
    usecase "UC-11 Вести рабочую сессию\n(ФТ-32)" as UC11
    usecase "UC-12 Просмотреть главную страницу\n(ФТ-20)" as UC12
  }
}

U --> UC01
U --> UC02
U --> UC03
U --> UC04
U --> UC05
U --> UC07
U --> UC08
U --> UC09
U --> UC10
U --> UC11
U --> UC12

