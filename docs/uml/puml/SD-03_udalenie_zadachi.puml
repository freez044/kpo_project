@startuml SD-03_udalenie_zadachi
!include seqhead.iuml
title SD-03. Удаление задачи со связанными данными (ФТ-09, НД-03)
actor "Пользователь" as U
box "Браузер пользователя" #F7FAFD
participant "Веб-интерфейс" as UI
participant "Модуль задач\nи целей" as TM
database "Хранилище\n(IndexedDB)" as DB
end box

U -> UI : удалить задачу
UI -> TM : что будет удалено?
TM -> DB : посчитать интервалы,\nсессии и файлы задачи
DB --> TM : количество записей
TM --> UI : состав удаляемых данных
UI --> U : окно подтверждения
alt пользователь подтвердил
  U -> UI : «Удалить»
  UI -> TM : deleteTask(id)
  group транзакция
    TM -> DB : удалить интервалы календаря
    TM -> DB : удалить рабочие сессии
    TM -> DB : удалить файлы
    TM -> DB : удалить задачу
  end
  alt транзакция завершена
    DB --> TM : ok
    TM --> UI : задача удалена
    UI --> U : карточка убрана с доски
  else ошибка
    DB --> TM : ошибка, изменения отменены
    TM --> UI : сообщение об ошибке
    UI --> U : «Не удалось удалить задачу»
  end
else отмена
  U -> UI : «Отмена»
end
@enduml
