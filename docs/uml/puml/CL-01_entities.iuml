' Сущности модели данных Adaptive AI Planner (ТЗ v11).
' Общий фрагмент: подключается в CL-01 (диаграмма классов) и в database/data_model.puml.
' Имена классов и полей совпадают с типами в docs/storage/db.ts.

skinparam ClassBackgroundColor #EEF4FB
skinparam ClassBorderColor #4A6FA5
skinparam ClassHeaderBackgroundColor #DCE7F5
skinparam StereotypeCBackgroundColor #C9DBF0
skinparam StereotypeEBackgroundColor #F4D8C9
skinparam StereotypeABackgroundColor #E2E2F0
skinparam ClassAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Перечисления" as ENUMS {
  enum TaskStatus {
    BACKLOG
    PLANNED
    IN_PROGRESS
    IN_HOLD
    DONE
    CANCELLED
  }
  enum GoalStatus {
    ACTIVE
    IN_HOLD
    COMPLETED
    CANCELLED
  }
  enum TaskPriority {
    LOW
    MEDIUM
    HIGH
    URGENT
  }
  enum TaskSource {
    MANUAL
    AI
  }
  enum LessonSource {
    ORIOKS
    FILE
  }
  enum ProposalKind {
    COMMAND
    DECOMPOSE
  }
  enum ProposalStatus {
    PENDING
    ACCEPTED
    EDITED
    REJECTED
  }
}

package "Основные данные" as CORE {
  class UserProfile <<единственная запись>> {
    +id: "me"
    +firstName: str
    +lastName: str
    +studyGroup: str
    +timezone: str
    +aiHistoryEnabled: bool
    +createdAt: datetime
    +updatedAt: datetime
  }

  class Category {
    +id: int
    +name: str {unique}
    +color: str [0..1]
  }

  class Goal {
    +id: int
    +title: str
    +description: str
    +status: GoalStatus
    +deadline: datetime [0..1]
    +categoryId: int [0..1]
    +durationMinutes: int [0..1]
    +createdAt: datetime
    +updatedAt: datetime
    --
    +calculateProgress(): float
  }

  class Task {
    +id: int
    +title: str
    +description: str
    +status: TaskStatus
    +priority: TaskPriority
    +deadline: datetime [0..1]
    +goalId: int [0..1]
    +categoryId: int [0..1]
    +durationMinutes: int [0..1]
    +order: int [0..1]
    +source: TaskSource
    +completedAt: datetime [0..1]
    +createdAt: datetime
    +updatedAt: datetime
    --
    +changeStatus(status: TaskStatus): void
    +isOverdue(): bool
  }

  class FileAttachment {
    +id: int
    +taskId: int [0..1]
    +goalId: int [0..1]
    +originalName: str
    +mimeType: str
    +sizeBytes: int
    +data: Blob
    +createdAt: datetime
  }
}

package "Календарь и расписание" as CAL {
  abstract class CalendarItem {
    +id: int
    +title: str
    +startAt: datetime
    +endAt: datetime
  }

  class CalendarEvent {
    +description: str [0..1]
  }

  class ScheduleItem {
    +taskId: int
  }

  class AcademicLesson {
    +discipline: str
    +lessonType: str [0..1]
    +room: str [0..1]
    +teacher: str [0..1]
    +source: LessonSource
    --
    +isReadOnly(): bool
  }

  class AcademicAssignment {
    +externalId: str
    +discipline: str
    +title: str
    +deadline: datetime [0..1]
    +isDone: bool [0..1]
    +fetchedAt: datetime
  }
}

package "ИИ-ассистент" as AIPKG {
  class AIProposal {
    +id: int
    +kind: ProposalKind
    +requestText: str
    +context: JSON [0..1]
    +responseData: JSON
    +finalData: JSON [0..1]
    +status: ProposalStatus
    +model: str
    +latencyMs: int [0..1]
    +createdAt: datetime
    --
    +confirm(finalData: JSON): void
    +reject(): void
  }
}

' ── Связи ──
Goal "0..1" o-- "0..*" Task : включает
Category "0..1" -- "0..*" Goal : классифицирует
Category "0..1" -- "0..*" Task : классифицирует
Task "1" *-- "0..*" ScheduleItem : планируется
Task "0..1" *-- "0..*" FileAttachment : вложения
Goal "0..1" *-- "0..*" FileAttachment : вложения

CalendarItem <|-- CalendarEvent
CalendarItem <|-- ScheduleItem
CalendarItem <|-- AcademicLesson

ENUMS -[hidden]down- CORE
CORE -[hidden]down- CAL
