' Сущности модели данных Adaptive AI Planner (ТЗ v12).
' Общий фрагмент: подключается в CL-01 (диаграмма классов) и в database/data_model.puml.
' Поля названы в camelCase, как в REST API; в базе данных те же поля в snake_case
' (database/postgresql/02_tables.sql). Идентификаторы — uuid.

skinparam ClassBackgroundColor #EEF4FB
skinparam ClassBorderColor #4A6FA5
skinparam ClassHeaderBackgroundColor #DCE7F5
skinparam StereotypeCBackgroundColor #C9DBF0
skinparam StereotypeEBackgroundColor #F4D8C9
skinparam StereotypeABackgroundColor #E2E2F0
skinparam ClassAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "Перечисления" as ENUMS {
  enum TaskStatus {
    BACKLOG
    PLANNED
    IN_PROGRESS
    IN_HOLD
    DONE
    CANCELLED
  }
  enum GoalStatus {
    ACTIVE
    IN_HOLD
    COMPLETED
    CANCELLED
  }
  enum TaskPriority {
    LOW
    MEDIUM
    HIGH
    URGENT
  }
  enum TaskSource {
    MANUAL
    AI
  }
  enum LessonSource {
    ORIOKS
    FILE
  }
  enum ProposalKind {
    COMMAND
    DECOMPOSE
  }
  enum ProposalStatus {
    PENDING
    ACCEPTED
    EDITED
    REJECTED
  }
}

package "Учётная запись" as ACCOUNT {
  class User {
    +id: uuid
    +email: str {unique}
    +passwordHash: str
    +firstName: str
    +lastName: str
    +studyGroup: str [0..1]
    +timezone: str
    +aiHistoryEnabled: bool
    +failedLoginCount: int
    +lockedUntil: datetime [0..1]
    +createdAt: datetime
    +updatedAt: datetime
  }

  class Session {
    +id: uuid
    +userId: uuid
    +refreshTokenHash: str {unique}
    +userAgent: str [0..1]
    +createdAt: datetime
    +lastUsedAt: datetime
    +expiresAt: datetime
    +revokedAt: datetime [0..1]
  }

  class OrioksConnection {
    +userId: uuid
    +tokenEncrypted: bytes
    +groupId: int
    +semesterStart: date
    +connectedAt: datetime
    +lastSyncAt: datetime [0..1]
    +lastSyncError: str [0..1]
  }
}

package "Цели и задачи" as CORE {
  class Category {
    +id: uuid
    +userId: uuid
    +name: str {unique у пользователя}
    +color: str [0..1]
  }

  class Goal {
    +id: uuid
    +userId: uuid
    +title: str
    +description: str
    +status: GoalStatus
    +deadline: datetime [0..1]
    +categoryId: uuid [0..1]
    +durationMinutes: int [0..1]
    +createdAt: datetime
    +updatedAt: datetime
    --
    +calculateProgress(): float
  }

  class Task {
    +id: uuid
    +userId: uuid
    +title: str
    +description: str
    +status: TaskStatus
    +priority: TaskPriority
    +deadline: datetime [0..1]
    +goalId: uuid [0..1]
    +categoryId: uuid [0..1]
    +durationMinutes: int [0..1]
    +sortOrder: int [0..1]
    +source: TaskSource
    +completedAt: datetime [0..1]
    +createdAt: datetime
    +updatedAt: datetime
    --
    +changeStatus(status: TaskStatus): void
    +isOverdue(): bool
  }

  class FileAttachment {
    +id: uuid
    +userId: uuid
    +taskId: uuid [0..1]
    +goalId: uuid [0..1]
    +originalName: str
    +mimeType: str
    +sizeBytes: int
    +storageKey: str
    +sha256: str
    +createdAt: datetime
  }
  note bottom of FileAttachment
    Заполнено ровно одно из taskId и goalId {xor}.
    Содержимое — в файловом хранилище сервера.
  end note
}

package "Календарь" as CAL {
  abstract class CalendarItem {
    +id: uuid
    +userId: uuid
    +title: str
    +startAt: datetime
    +endAt: datetime
  }

  class CalendarEvent {
    +description: str [0..1]
  }

  class ScheduleItem {
    +taskId: uuid
  }

  class AcademicLesson {
    +discipline: str
    +lessonType: str [0..1]
    +room: str [0..1]
    +teacher: str [0..1]
    +source: LessonSource
    --
    +isReadOnly(): bool
  }
}

package "Учебные данные ОРИОКС" as ORIOKS_DATA {
  class AcademicAssignment {
    +id: uuid
    +userId: uuid
    +externalId: str
    +discipline: str
    +title: str
    +controlType: str
    +week: int
    +deadline: datetime [0..1]
    +maxGrade: float [0..1]
    +isDone: bool
    +fetchedAt: datetime
  }
}

package "ИИ-ассистент" as AIPKG {
  class AIProposal {
    +id: uuid
    +userId: uuid
    +goalId: uuid [0..1]
    +kind: ProposalKind
    +requestText: str
    +context: JSON
    +responseData: JSON
    +finalData: JSON [0..1]
    +status: ProposalStatus
    +model: str
    +latencyMs: int [0..1]
    +createdAt: datetime
    +decidedAt: datetime [0..1]
    --
    +confirm(finalData: JSON): void
    +reject(): void
  }
}

' ── Связи ──
User "1" *-- "0..*" Session : сеансы
User "1" *-- "0..1" OrioksConnection : ОРИОКС
note right of User
  Каждая запись остальных сущностей
  принадлежит одному пользователю (userId)
  и удаляется вместе с ним (ФТ-05).
  Связи между записями — только
  в пределах одного пользователя.
end note

Goal "0..1" o-- "0..*" Task : включает
Category "0..1" -- "0..*" Goal : классифицирует
Category "0..1" -- "0..*" Task : классифицирует
Task "1" *-- "0..*" ScheduleItem : планируется
Task "0..1" *-- "0..*" FileAttachment : вложения
Goal "0..1" *-- "0..*" FileAttachment : вложения
Goal "0..1" -- "0..*" AIProposal : декомпозиция

CalendarItem <|-- CalendarEvent
CalendarItem <|-- ScheduleItem
CalendarItem <|-- AcademicLesson

ACCOUNT -[hidden]down- ENUMS
ACCOUNT -[hidden]right- CORE
