@startuml LD-01_urovni
!include style.iuml
title LD-01. Уровни (слои) архитектуры Adaptive AI Planner (ТЗ v12)

package "Клиент: браузер на любом устройстве" as CLIENT {
  package "1. Уровень представления" as L1 #EEF4FB {
    rectangle "Экраны React: вход, главная, канбан-доска, цели,\nкалендарь, ИИ-ассистент, профиль\n—\nформы, перетаскивание, подтверждения,\nсообщения об ошибках, адаптивная вёрстка" as R1
  }
  rectangle "API-клиент (HTTPS, JSON):\naccess-токен, обновление сеанса,\nкопия для просмотра без сети (IndexedDB)" as APIC
}

package "Сервер" as SERVER {
  package "2. Уровень API" as L2 #F5EEF8 {
    rectangle "FastAPI: REST API (OpenAPI), проверка токена и прав,\nпроверка запросов (Pydantic), единый формат ошибок" as R2
  }
  package "3. Уровень бизнес-логики" as L3 #EAF5EA {
    rectangle "Сервисы: учётные записи, задачи, цели, категории,\nкалендарь, файлы, планирование, ОРИОКС, ИИ\n—\nправила ФТ, расчёт просрочки, прогресса,\nпересечений и нагрузки" as R3
  }
  package "4. Уровень доступа к данным" as L4 #FFF6E5 {
    rectangle "Слой данных (SQLAlchemy): запросы, транзакции (НД-03),\nмиграции Alembic" as R4
  }
  package "5. Уровень хранения" as L5 #F2F2F2 {
    database "PostgreSQL" as R5
    rectangle "Файловое\nхранилище" as R5F
  }
  package "Интеграции" as L6 #F5EEF8 {
    rectangle "LLMAdapter (заменяемый),\nклиент ОРИОКС;\nдо 2 повторов, 60 с на операцию (НД-01)" as R6
  }
}

package "Внешние системы" as EXT {
  rectangle "LLM API" as E1
  rectangle "ОРИОКС" as E2
}

R1 -down-> APIC : вызовы API
APIC -right-> R2 : HTTPS
R2 -down-> R3 : вызовы сервисов
R3 -down-> R4 : чтение и запись
R4 -down-> R5
R3 -down-> R5F : файлы
R3 -right-> R6 : запросы к ИИ\nи ОРИОКС
R6 -down-> E1
R6 -down-> E2

note right of R1
  Каждый уровень обращается
  только к уровню ниже;
  браузер не работает с базой,
  LLM и ОРИОКС напрямую
end note
@enduml
