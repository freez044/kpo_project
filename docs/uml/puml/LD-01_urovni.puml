@startuml LD-01_urovni
!include style.iuml
title LD-01. Уровни (слои) архитектуры Adaptive AI Planner
skinparam packageStyle rectangle
skinparam RectangleFontStyle plain
skinparam PackageFontStyle bold
skinparam nodesep 30
skinparam ranksep 40

package "Клиент: браузер пользователя" as CLIENT {
  package "1. Уровень представления" as L1 #EEF4FB {
    rectangle "Экраны React: главная, канбан-доска, цели,\nкалендарь, ИИ-ассистент, профиль\n—\nотображение, формы, перетаскивание,\nподтверждения, сообщения об ошибках" as R1
  }
  package "2. Уровень бизнес-логики" as L2 #EAF5EA {
    rectangle "Модули: задачи и цели, календарь и расписание,\nконтроль нагрузки, рабочие сессии, файлы,\nИИ (проверка ответа), профиль и резервная копия\n—\nправила ФТ, проверка данных (НД-04),\nрасчёт просрочки, прогресса, пересечений" as R2
  }
  package "3. Уровень доступа к данным" as L3 #FFF6E5 {
    rectangle "Dexie (db.ts): таблицы, индексы, транзакции (НД-03),\nэкспорт и импорт резервной копии" as R3
  }
  package "4. Уровень хранения" as L4 #F2F2F2 {
    database "IndexedDB браузера" as R4
  }
  rectangle "API-клиент\n(HTTPS, JSON)" as APIC
}

package "Сервер" as SERVER {
  package "5. Уровень интеграции" as L5 #F5EEF8 {
    rectangle "FastAPI: REST API (OpenAPI), единый формат ошибок,\nтаймаут 60 с и 2 повтора (НД-01)\n—\nадаптер языковой модели (заменяемый), адаптер ОРИОКС;\nпользовательские данные не хранятся" as R5
  }
}

package "Внешние системы" as EXT {
  rectangle "LLM API" as E1
  rectangle "ОРИОКС" as E2
}

R1 -down-> R2 : вызовы модулей
R2 -down-> R3 : чтение и запись
R3 -down-> R4
R2 -right-> APIC : запросы к ИИ\nи ОРИОКС
APIC -down-> R5
R5 -down-> E1
R5 -down-> E2

note right of R1
  Каждый уровень обращается
  только к уровню ниже;
  интерфейс не работает
  с хранилищем напрямую
end note
@enduml
