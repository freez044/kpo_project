@startuml SD-07_vosstanovlenie
!include seqhead.iuml
title SD-07. Восстановление данных из резервной копии (ФТ-04, НД-04)
actor "Пользователь" as U
box "Браузер пользователя" #F7FAFD
participant "Веб-интерфейс" as UI
participant "Модуль профиля\nи хранения" as PM
database "Хранилище\n(IndexedDB)" as DB
end box

U -> UI : «Восстановить из файла»
UI --> U : выбор файла и предупреждение\nо замене текущих данных
U -> UI : файл резервной копии
UI -> PM : restoreBackup(файл)
PM -> PM : проверить формат, имя базы\nи версию схемы
alt файл не подходит
  PM --> UI : ValidationError
  UI --> U : «Файл не является резервной\nкопией Adaptive AI Planner»
else файл подходит
  PM -> DB : выгрузить снимок текущих данных
  DB --> PM : снимок
  PM -> DB : очистить таблицы\nи импортировать файл
  alt импорт успешен
    DB --> PM : ok
    PM --> UI : данные восстановлены
    UI --> U : обновлённые экраны
  else ошибка импорта
    DB --> PM : ошибка
    PM -> DB : вернуть данные из снимка
    PM --> UI : файл повреждён
    UI --> U : «Текущие данные не изменены»
  end
end
@enduml
