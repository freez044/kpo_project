# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Адрес PostgreSQL для сервера и миграций Alembic.
DATABASE_URL=postgresql+psycopg://planner_backend:change-me@localhost:5432/planner

# Current account server is local SQLite; DATABASE_URL is for existing PG tooling.
# Set true only when serving the frontend and API over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Email sender for password-reset codes. Copy to root .env; never commit secrets.
# Use a separate project mailbox and an app-specific SMTP password.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
# Uncomment and fill with the real sender address:
# AUTH_SMTP_FROM=planner@example.com
# false: implicit TLS on 465; true: STARTTLS on 587. Plain SMTP is not supported.
AUTH_SMTP_STARTTLS=false
